{
  "name": "dsh-screen-saver",
  "version": "1.0.0",
  "private": true,
  "description": "屏幕常亮插件 —— 为 DSH/DSHM 提供独立设置分区与会话 dock 入口；开启后经 Screen Wake Lock API（navigator.wakeLock）保持屏幕常亮，切后台自动释放、回前台自动续期，状态持久化。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmls2007/dsh-screen-saver.git"
  },
  "homepage": "https://github.com/mmls2007/dsh-screen-saver#readme",
  "bugs": {
    "url": "https://github.com/mmls2007/dsh-screen-saver/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "screen",
    "wake-lock",
    "keep-screen-on"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  }
}
